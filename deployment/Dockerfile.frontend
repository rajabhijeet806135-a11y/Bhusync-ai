# ──────────────────────────────────────────────────────────────────────────────
# BhuSynch AI — Frontend Docker Image
# NGINX-based static file server for 3D Web-GIS Console
# ──────────────────────────────────────────────────────────────────────────────

FROM nginx:1.25-alpine

LABEL maintainer="BhuSynch AI Team"
LABEL description="BhuSynch AI frontend — MapLibre GL + Deck.gl 3D Web-GIS Console"

# Remove default NGINX site
RUN rm -rf /usr/share/nginx/html/*

# Copy frontend files
COPY frontend/ /usr/share/nginx/html/
COPY mobile-pwa/ /usr/share/nginx/html/mobile/

# Copy custom NGINX configuration
COPY deployment/nginx/default.conf /etc/nginx/conf.d/default.conf

# Create cache and log directories
RUN mkdir -p /var/cache/nginx /var/log/nginx && \
    chown -R nginx:nginx /var/cache/nginx /var/log/nginx /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
